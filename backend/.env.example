NODE_ENV=development
PORT=5000
JWT_SECRET=your-super-secret-jwt-key-change-this

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vololeads
DATABASE_SSL=false

API_BASE_URL=http://localhost:5000

# CORS Origins (comma-separated for multiple origins)
# Dev: http://localhost:3000
# Prod: https://vololeads.com
CORS_ORIGIN=http://localhost:3000,https://vololeads.com

LOG_LEVEL=debug

# Google Sheets sync (Apps Script / automation calls GET /api/export/*)
SHEETS_SYNC_API_KEY=generate-a-long-random-secret-here

# Admin API (protects GET/PATCH /api/contact-forms*)
ADMIN_API_KEY=generate-a-different-long-random-secret-here

# Contact form admin alerts + calendar owner for Google Meet bookings
CONTACT_EMAIL=vololeads@gmail.com

# Google Calendar + Meet (sign in as vololeads@gmail.com during setup)
# 1. https://console.cloud.google.com → create project → enable Google Calendar API
# 2. Credentials → Create OAuth client → Desktop app
# 3. Put client id/secret below, then run: npm run setup:google-calendar
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_MEET_DURATION_MINUTES=30

# New subscription alerts (who subscribed + plan). Defaults to vololeads@gmail.com if unset.
SUBSCRIPTION_NOTIFY_EMAIL=vololeads@gmail.com
THANK_YOU_PAGE=https://vololeads.com/thank-you.html

# Security Settings
HASH_SALT=your-unique-hash-salt-for-ip-hashing
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=3

# Cloudflare Turnstile
# Frontend site key goes in frontend/index.html and frontend/manage-subscription.html.
# Backend secret key stays server-side only.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Stripe Billing
APP_BASE_URL=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ESSENTIAL_WEEKLY_RECURRING=price_replace_me
STRIPE_PRICE_ESSENTIAL_WEEKLY_SETUP=price_replace_me
STRIPE_PRICE_PREMIUM_MONTHLY=price_replace_me
STRIPE_PRICE_CUSTOM_PLUS_MONTHLY=price_replace_me

# Subscription Emails
EMAIL_FROM=billing@yourdomain.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_TLS_SERVERNAME=mail.yourdomain.com
